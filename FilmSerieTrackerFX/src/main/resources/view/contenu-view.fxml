<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.maisonneuve.filmserietrackerfx.controller.ContenuController">

    <!-- TON LAYOUT PRINCIPAL -->
    <BorderPane>

    <!-- ================= TOP (FORMULAIRE) ================= -->

    <top>
        <VBox>
            <!-- HEADER -->
            <HBox alignment="CENTER"
                  spacing="15"
                  styleClass="app-header">

                <Label text="🎬 Film &amp; Série Tracker"
                       styleClass="app-title"/>

            </HBox>

            <!-- FORMULAIRE CENTRÉ -->
            <StackPane alignment="CENTER">
                <VBox spacing="20"
                      styleClass="card-form"
                      maxWidth="900">

                    <padding>
                        <Insets top="25" right="40" bottom="25" left="40"/>
                    </padding>

                    <Label text="Ajouter un Film / Série"
                           style="-fx-text-fill: #f59e0b; -fx-font-size: 20px; -fx-font-weight: bold;"/>

                    <!-- GRID FORMULAIRE -->
                    <GridPane hgap="30" vgap="18">

                        <!-- Ligne 1 -->
                        <Label text="Type" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="typeCombo"
                                  prefWidth="180"
                                  GridPane.rowIndex="0"
                                  GridPane.columnIndex="1"/>

                        <Label text="Genre" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <ComboBox fx:id="genreCombo"
                                  prefWidth="180"
                                  GridPane.rowIndex="0"
                                  GridPane.columnIndex="3"/>

                        <!-- Ligne 2 -->
                        <Label text="Titre" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="titreField"
                                   prefWidth="180"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="1"/>

                        <Label text="Année" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                        <TextField fx:id="anneeField"
                                   prefWidth="180"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="3"/>

                        <!-- Ligne 3 -->
                        <Label text="Statut" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="statutCombo"
                                  prefWidth="180"
                                  GridPane.rowIndex="2"
                                  GridPane.columnIndex="1"/>

                        <Label text="Note" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                        <ComboBox fx:id="noteCombo"
                                  prefWidth="180"
                                  GridPane.rowIndex="2"
                                  GridPane.columnIndex="3"/>

                        <!-- Ligne 4 -->
                        <CheckBox fx:id="watchlistCheck"
                                  text="Ajouter à la Watchlist"
                                  GridPane.rowIndex="3"
                                  GridPane.columnIndex="0"/>

                        <Button text="+ Ajouter"
                                styleClass="btn-add"
                                onAction="#ajouterContenu"
                                prefWidth="180"
                                GridPane.rowIndex="3"
                                GridPane.columnIndex="3"/>

                    </GridPane>

                    <!-- ================= PROGRESSION SERIE ================= -->

                    <VBox fx:id="progressionBox"
                          spacing="12"
                          visible="false"
                          managed="false">

                        <Separator/>

                        <Label text="Progression Série"
                               style="-fx-text-fill: #f59e0b; -fx-font-weight: bold;"/>

                        <HBox spacing="15" alignment="CENTER_LEFT">

                            <Label text="Episodes vus:"/>
                            <TextField fx:id="episodesVusField" prefWidth="80"/>

                            <Label text="Episodes totaux:"/>
                            <TextField fx:id="episodesTotalField" prefWidth="80"/>

                        </HBox>

                        <ProgressBar fx:id="serieProgressBar"
                                     prefWidth="400"
                                     progress="0"/>

                        <Label fx:id="progressLabel"
                               text="0%"
                               style="-fx-font-weight: bold;"/>

                    </VBox>

                </VBox>
            </StackPane>

        </VBox>
    </top>



    <!-- ================= CENTER (TABLEVIEW) ================= -->

    <center>
        <StackPane alignment="CENTER">

        <HBox spacing="40" alignment="CENTER" fillHeight="true">
            <!-- TABLE CARD -->
            <VBox styleClass="card-table">

                <TableView fx:id="tableContenus"
                           prefHeight="400">

                    <columns>
                        <TableColumn fx:id="colTitre" text="Titre" prefWidth="180"/>
                        <TableColumn fx:id="colAnnee" text="Année" prefWidth="80"/>
                        <TableColumn fx:id="colType" text="Type" prefWidth="80"/>
                        <TableColumn fx:id="colGenre" text="Genre" prefWidth="120"/>
                        <TableColumn fx:id="colStatut" text="Statut" prefWidth="120"/>
                        <TableColumn fx:id="colWatchlist" text="Watchlist" prefWidth="100"/>
                        <TableColumn fx:id="colNote" text="Note" prefWidth="70"/>
                        <TableColumn fx:id="colProgress" text="Progression" prefWidth="200"/>
                    </columns>

                </TableView>

            </VBox>
            <!-- RECHERCHE CARD -->
            <VBox spacing="15"
                  styleClass="card-form"
                  maxWidth="250">

                <Label text="Recherche"
                       styleClass="section-title"/>

                <TextField fx:id="searchField"
                           promptText="Rechercher par titre..."/>

            </VBox>
<!--            <VBox spacing="10" styleClass="card-search">-->

<!--                <padding>-->
<!--                    <Insets top="20" right="20" bottom="20" left="20"/>-->
<!--                </padding>-->

<!--                <Label text="Recherche"-->
<!--                       styleClass="section-title"/>-->

<!--                <TextField fx:id="searchField"-->
<!--                           promptText="Rechercher par titre..."/>-->

<!--            </VBox>-->

        </HBox>

        </StackPane>
    </center>

    <!-- ================= BOTTOM (ACTIONS + STATS) ================= -->

    <bottom>
        <StackPane alignment="CENTER">
            <VBox spacing="20"
                  styleClass="card-form"
                  maxWidth="900">

                <padding>
                    <Insets top="20" right="40" bottom="20" left="40"/>
                </padding>

                <HBox spacing="20">
                    <Button text="Modifier"
                            styleClass="btn-edit"
                            onAction="#modifierContenu"/>

                    <Button text="Supprimer"
                            styleClass="btn-delete"
                            onAction="#supprimerContenu"/>
                </HBox>

                <HBox spacing="30">
                    <Label text="Total:"/>
                    <Label fx:id="totalLabel" styleClass="stats-label"/>

                    <Label text="Films:"/>
                    <Label fx:id="filmsLabel" styleClass="stats-label"/>

                    <Label text="Séries:"/>
                    <Label fx:id="seriesLabel" styleClass="stats-label"/>

                    <Label text="Watchlist:"/>
                    <Label fx:id="watchlistLabel" styleClass="stats-label"/>
                </HBox>

            </VBox>
        </StackPane>
    </bottom>
</BorderPane>
    <StackPane fx:id="toastContainer"
               alignment="BOTTOM_RIGHT"
               mouseTransparent="true">

        <padding>
            <Insets bottom="40" right="40"/>
        </padding>

        <Label fx:id="toastLabel"
               visible="false"
               managed="false"
               styleClass="toast"/>
    </StackPane>
        </StackPane>